# Clave de la API de Anthropic (nunca commitear el .env real)
ANTHROPIC_API_KEY=
# Modelo que responde en los tres brazos (por defecto claude-haiku-5-5)
MODELO_RESPUESTA=claude-haiku-5-5
# Modelo juez (por defecto claude-haiku-5-5)
MODELO_JUEZ=claude-haiku-5-5
# Effort: low | medium | high | xhigh | max (por defecto low)
ESFUERZO=low
# Tope de gasto por corrida en USD; la corrida se corta si lo supera
PRESUPUESTO_USD=0.50
